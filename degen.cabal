cabal-version:       3.0
build-type:          Simple


name:                degen
version:             1.0.0
synopsis:            Just an experiment; I'll probably nuke this later
homepage:            https://github.com/thesnakefromthelemma/degen


author:              thesnakefromthelemma
maintainer:          thesnakefromthelemma@gmail.com
license:             BSD-3-Clause
license-file:        LICENSE


extra-doc-files:     CHANGELOG.md
                     README.md

source-repository    head
    type:            git
    location:        https://github.com/thesnakefromthelemma/degen


common                   common

    build-depends:       base ^>= 4.21.0.0

    default-language:    Haskell2010

    ghc-options:         -Wall
                         -O2
                         -fllvm


library

    import:             common

    hs-source-dirs:     src

    build-depends:      vector ^>= 0.13.2.0
                 ,      vector-algorithms ^>= 0.9.1.0

    exposed-modules:    HyperVector
                        Sid
                        Archer

    other-modules:      Misc


test-suite             degen-test

    import:            common

    hs-source-dirs:    test
    
    type:              exitcode-stdio-1.0

    build-depends:     degen == 1.0.0
                 ,     random ^>= 1.3.1   
                 ,     vector ^>= 0.13.2.0

    main-is:           Main.hs


benchmark              degen-bench

    import:            common

    hs-source-dirs:    bench

    type:              exitcode-stdio-1.0

    build-depends:     degen == 1.0.0
                 ,     random ^>= 1.3.1
                 ,     vector ^>= 0.13.2.0

    main-is:           Main.hs

    ghc-options:       -rtsopts -prof
